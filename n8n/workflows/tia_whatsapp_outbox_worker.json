{
  "name": "Linka WhatsApp Transport Tick",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "seconds",
              "secondsInterval": 5
            }
          ]
        }
      },
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        -240,
        0
      ],
      "id": "574fe720-6445-443b-b26d-142a1dd94fe5",
      "name": "Every 5 Seconds"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ ($env.TIA_API_BASE_URL || 'http://host.docker.internal:8000') + '/api/v1/channels/whatsapp/transport/tick?limit_per_connection=10&max_connections=25' }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 120000
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        20,
        0
      ],
      "id": "c6ef1180-fc1f-4cb1-99b0-d8d59b531320",
      "name": "Linka Native WhatsApp Tick",
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    }
  ],
  "connections": {
    "Every 5 Seconds": {
      "main": [
        [
          {
            "node": "Linka Native WhatsApp Tick",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "pinData": {},
  "settings": {
    "executionOrder": "v1",
    "timezone": "Africa/Cairo"
  },
  "meta": {
    "templateCredsSetupCompleted": false,
    "note": "This workflow uses one Linka platform X-Tia-Transport-Token credential. Clinic Meta credentials stay encrypted in Linka and are never configured in n8n."
  },
  "tags": []
}
