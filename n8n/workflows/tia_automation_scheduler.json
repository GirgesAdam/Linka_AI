{
  "name": "Linka Automation + Clinic Sync Scheduler",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 1
            }
          ]
        }
      },
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        -520,
        0
      ],
      "id": "b48bae5f-635f-479f-8959-b5e30ca3d9e3",
      "name": "Every Minute"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ ($env.TIA_API_BASE_URL || 'http://host.docker.internal:8000') + '/api/v1/automations/adapter/tick' }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"limit\": 20,\n  \"planning_horizon_days\": 14\n}",
        "options": {
          "timeout": 30000
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -280,
        0
      ],
      "id": "74f76ee8-b70f-4225-ae24-e29f4929d0e8",
      "name": "Linka Plan + Claim",
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    },
    {
      "parameters": {
        "jsCode": "const data = $json.body ?? $json;\nconst jobs = Array.isArray(data.claimed) ? data.claimed : [];\nreturn jobs.map((job, i) => ({json: job, pairedItem: {item: 0}}));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -40,
        0
      ],
      "id": "9a7a5fcf-8804-47d7-83e7-3bea1acf6a77",
      "name": "Expand Claimed Jobs"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ ($env.TIA_API_BASE_URL || 'http://host.docker.internal:8000') + '/api/v1/automations/adapter/jobs/' + $json.job_id + '/execute' }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 30000
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        200,
        0
      ],
      "id": "7f31e1eb-9bf3-4f00-93e5-f33cc1c4b6b9",
      "name": "Linka Execute Automation",
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ ($env.TIA_API_BASE_URL || 'http://host.docker.internal:8000') + '/api/v1/automations/adapter/clinic-sync/tick' }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"page_size\": 100,\n  \"max_pages_per_domain\": 10\n}",
        "options": {
          "timeout": 120000
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -280,
        240
      ],
      "id": "6dd27cf9-1506-47e0-b33a-0a63f3da23ab",
      "name": "Linka Clinic Sync Tick",
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    }
  ],
  "connections": {
