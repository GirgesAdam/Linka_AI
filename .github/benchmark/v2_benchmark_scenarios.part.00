def _single_session_booking(db: Session, workspace: Workspace) -> PreparedScenario:
    patient, _catalog, service, doctor, _branch, day, available, tz, slot = generic_context(db, workspace)
    return PreparedScenario(
        patient=patient,
        messages=[
            f"عايز أحجز جلسة {service['name']} مع {doctor['name']} يوم {day.isoformat()}، إيه المواعيد المتاحة؟",
            f"تمام احجزلي الساعة {slot.start_at.astimezone(tz).strftime('%H:%M')} دلوقتي",
        ],
    )


def _package_purchase(db: Session, workspace: Workspace) -> PreparedScenario:
    patient = patient_without_future(db, workspace)
    offer = package_offer(
        db,
        workspace,
        service_name="ليزر إزالة الشعر - إبط",
        sessions=6,
        device_key="prime_lase",
    )
    return PreparedScenario(
        patient=patient,
        observations=["target_offer=" + json.dumps(jsonable(offer), ensure_ascii=False, separators=(",", ":"))],
        messages=[
            "بكام باكيدج 6 جلسات ليزر إزالة شعر الإبط على جهاز Prime Lase؟",
            "تمام، اشتريلي الباكيدج دي دلوقتي",
        ],
    )


def _session_vs_package_ambiguity(db: Session, workspace: Workspace) -> PreparedScenario:
    return PreparedScenario(
        patient=patient_without_future(db, workspace),
        messages=[
            "عايز أعمل full body",
            "أنا لسه محددتش Session ولا Package، إيه الاختيارات المتاحة؟",
        ],
        observations=["expected_write_delta=0"],
    )


def _existing_package_booking(db: Session, workspace: Workspace) -> PreparedScenario:
    patient, package, read = package_patient(db, workspace)
    service = db.get(Service, package.service_id)
    if service is None:
        raise RuntimeError("Package service missing")
    _catalog, doctor, day, available = availability(
        db,
        workspace,
        service_id=service.id,
        device_key=package.laser_device_key,
    )
    tz = ZoneInfo(available.timezone)
    slot = available.slots[0]
    return PreparedScenario(
        patient=patient,
        observations=[
            f"package_id={package.id}",
            f"package_remaining_before={read.sessions_remaining}",
            f"package_service={service.name}",
        ],
        messages=[
            f"عندي باكيدج {service.name} شغالة وعايز أحجز منها الجلسة الجاية يوم {day.isoformat()} مع {doctor['name']}، إيه المتاح؟",
            f"تمام احجزلي الساعة {slot.start_at.astimezone(tz).strftime('%H:%M')} من الباكيدج",
        ],
    )


