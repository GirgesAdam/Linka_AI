def _package_comparison(db: Session, workspace: Workspace) -> PreparedScenario:
    prime = package_offer(
        db, workspace, service_name="ليزر إزالة الشعر - إبط", sessions=6, device_key="prime_lase"
    )
    candela = package_offer(
        db, workspace, service_name="ليزر إزالة الشعر - إبط", sessions=6, device_key="candela_gentle"
    )
    return PreparedScenario(
        patient=patient_without_future(db, workspace),
        observations=[
            "prime_offer=" + json.dumps(jsonable(prime), ensure_ascii=False, separators=(",", ":")),
            "candela_offer=" + json.dumps(jsonable(candela), ensure_ascii=False, separators=(",", ":")),
            "expected_write_delta=0",
        ],
        messages=[
            "قارنلي باكيدج 6 جلسات إزالة شعر الإبط على Prime Lase وباكيدج 6 جلسات على Candela Gentle من ناحية السعر"
        ],
    )


def _hypothetical_question(db: Session, workspace: Workspace) -> PreparedScenario:
    patient, package, read = package_patient(db, workspace)
    service = db.get(Service, package.service_id)
    service_name = service.name if service else "الخدمة"
    return PreparedScenario(
        patient=patient,
        observations=[
            f"package_id={package.id}",
            f"remaining={read.sessions_remaining}",
            "expected_write_delta=0",
        ],
        messages=[
            f"لو عندي باكيدج {service_name} وبعدين حبيت أغير ميعاد جلسة أو ألغيها، إيه اللي بيحصل؟",
        ],
    )


