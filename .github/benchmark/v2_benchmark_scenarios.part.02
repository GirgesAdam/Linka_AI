؟",
            f"تمام احجزلي مع {doctor_b['name']} الساعة {target_time}",
        ],
    )


def _change_service_mid_conversation(db: Session, workspace: Workspace) -> PreparedScenario:
    patient = patient_without_future(db, workspace)
    _catalog, service_a, doctor_a, _branch, day_a, _available_a = base._booking_context(db, workspace)
    _catalog2, service_b, doctor_b, _branch2, day_b, _available_b = base._booking_context(
        db, workspace, exclude_service_id=str(service_a["id"])
    )
    return PreparedScenario(
        patient=patient,
        observations=[f"service_a={service_a['name']}", f"service_b={service_b['name']}"],
        messages=[
            f"إيه مواع؊د {service_a['name']} مع {doctor_a['name']} يوم {day_a.isoformat()}؟",
            f"سيب {service_a['name']}، أنا غيرت رأيي وعايز {service_b['name']} مع {doctor_b['name']} يوم {day_b.isoformat()}، إيه المتاح؟",
        ],
    )


