def _laser_device_consistency(db: Session, workspace: Workspace) -> PreparedScenario:
    patient = patient_without_future(db, workspace)
    service = service_by_name(db, workspace, "ليزر إزالة الشعر - إبط")
    catalog, _doctor, day, available = availability(
        db,
        workspace,
        service_id=service.id,
        device_key="prime_lase",
    )
    tz = ZoneInfo(available.timezone)
    slot = available.slots[0]
    selected_doctor = doctor_name(catalog, slot.doctor_id)
    return PreparedScenario(
        patient=patient,
        observations=["expected_device=prime_lase"],
        messages=[
            f"جلسة {service.name} على Prime Lase بكام، ومين متاح يوم {day.isoformat()}؟",
            f"تمام احجزلي على Prime Lase مع {selected_doctor} الساعة {slot.start_at.astimezone(tz).strftime('%H:%M')}",
        ],
    )


