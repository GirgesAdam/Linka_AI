def _two_packages_same_visit(db: Session, workspace: Workspace) -> PreparedScenario:
    patient = patient_without_future(db, workspace)
    offer_a = package_offer(
        db, workspace, service_name="ليزر إزالة الشعر - إبط", sessions=6, device_key="prime_lase"
    )
    offer_b = package_offer(
        db, workspace, service_name="ليزر إزالة الشعر - بكيني", sessions=6, device_key="prime_lase"
    )
    return PreparedScenario(
        patient=patient,
        observations=[
            "offer_a=" + json.dumps(jsonable(offer_a), ensure_ascii=False, separators=(",", ":")),
            "offer_b=" + json.dumps(jsonable(offer_b), ensure_ascii=False, separators=(",", ":")),
            "required_rule=one_common_doctor_one_visit_one_appointment_time_for_both_services",
        ],
        messages=[
            "بكام باكيدج 6 جلسات ليزر إبط وباكيدج 6 جلسات بكيني على Prime Lase؟ وإيه أقرب ميعاد متاح أقدر أعمل فيه أول جلسة للخدمتين مع بعض في نفس الزيارة مع نفس الدكتور؟",
            "تمام، اشتريلي الباكيدجين واحجزلي أول زيارة للخدمتين مع بعض على أقرب ميعاد مناسب، نفس الدكتور وفي زيارة واحدة",
        ],
    )


