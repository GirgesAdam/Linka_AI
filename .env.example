APP_NAME=Linka
ENVIRONMENT=staging
DEBUG=false
API_V1_PREFIX=/api/v1
DOCS_ENABLED=true
LOG_LEVEL=INFO

DATABASE_URL=postgresql+psycopg://postgres.PROJECT_REF:YOUR_PASSWORD@YOUR_POOLER_HOST:5432/postgres
MIGRATION_DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres

SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME

# OpenAI-only LLM stack. Luna handles normal traffic; GPT-5 mini is the
# affordable cross-model fallback for temporary provider/model 5xx failures.
LLM_PROVIDER=openai
OPENAI_API_KEY=REPLACE_ME
OPENAI_MODEL=gpt-6-luna
OPENAI_FALLBACK_MODEL=gpt-5-mini
OPENAI_REASONING_EFFORT=low
OPENAI_FALLBACK_REASONING_EFFORT=low
OPENAI_ONBOARDING_MAX_OUTPUT_TOKENS=8192
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
LLM_REALTIME_MAX_RETRIES=0
LLM_REALTIME_CIRCUIT_BREAKER_COOLDOWN_SECONDS=120
LLM_MAX_OUTPUT_TOKENS=2048

# Semantic/workflow orchestration bounds
AGENT_UNIFIED_TURN_INTERPRETER_ENABLED=true
AGENT_SEMANTIC_ROUTER_ENABLED=true
AGENT_ROUTER_MAX_OUTPUT_TOKENS=1024
AGENT_ROUTER_HISTORY_MESSAGES=8
AGENT_FLOW_INTERPRETER_MAX_OUTPUT_TOKENS=1024
AGENT_FLOW_INTERPRETER_HISTORY_MESSAGES=8
AGENT_FLOW_TTL_HOURS=24

# Product-quality context bounds
AGENT_HISTORY_MESSAGES=24
AGENT_OPERATIONAL_CONTEXT_ITEMS=8
AGENT_OPERATIONAL_CONTEXT_MAX_CHARS=16000
AGENT_RECURSION_LIMIT=8
AGENT_MAX_TOOL_ROUNDS=2
AGENT_PREFETCH_READS_ENABLED=true
CHANNEL_DISPATCH_MAX_ATTEMPTS=5

# Meta Graph API version shared by Linka's Meta transports. Keep this pinned until a
# separately validated version-upgrade task moves WhatsApp + social transports together.
META_GRAPH_API_VERSION=v25.0

# Linka-owned Meta Business App for Messenger / Instagram OAuth + webhook verification.
# These are server-only. Never prefix secrets with NEXT_PUBLIC_.
META_APP_ID=REPLACE_ME
META_APP_SECRET=REPLACE_ME
META_OAUTH_REDIRECT_URI=https://YOUR_BACKEND_ORIGIN/api/v1/channels/meta/oauth/callback
META_WEBHOOK_CALLBACK_URL=https://YOUR_BACKEND_ORIGIN/api/v1/webhooks/meta
META_WEBHOOK_VERIFY_TOKEN=REPLACE_WITH_RANDOM_SECRET
META_OAUTH_STATE_SIGNING_KEY=REPLACE_WITH_RANDOM_SECRET
META_FACEBOOK_LOGIN_CONFIG_ID=REPLACE_ME

# Linka native channel credential storage / worker authentication. Per-clinic Meta access
# tokens belong in encrypted ChannelProviderCredential rows, not environment variables.
CHANNEL_CREDENTIAL_ENCRYPTION_KEY=REPLACE_WITH_FERNET_KEY
CHANNEL_TRANSPORT_WORKER_TOKEN=REPLACE_WITH_RANDOM_SECRET

# Accepts one origin, comma-separated origins, or a JSON array.
# Production migration target: include https://app.linkaai.online. Keep
# https://app.tiaai.online temporarily during the compatibility window.
CORS_ORIGINS=http://localhost:3000

DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT_SECONDS=30
DB_POOL_RECYCLE_SECONDS=1800

# Dedicated reporting capacity: analytics can become busy without starving booking.
ANALYTICS_DB_POOL_SIZE=2
ANALYTICS_DB_MAX_OVERFLOW=0
ANALYTICS_DB_POOL_TIMEOUT_SECONDS=3
ANALYTICS_STATEMENT_TIMEOUT_MS=10000
ANALYTICS_AGGREGATE_CACHE_TTL_SECONDS=5
ANALYTICS_AGGREGATE_CACHE_MAX_ENTRIES=256
ANALYTICS_EXPORT_MAX_ROWS=5000
ANALYTICS_EXPORT_MAX_BYTES=5000000

# Frontend (.env.local)
NEXT_PUBLIC_SUPABASE_URL=https://PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
NEXT_PUBLIC_APP_URL=https://app.linkaai.online
LINKA_LEGACY_DOMAIN_REDIRECT_ENABLED=false
TIA_API_URL=http://127.0.0.1:8000
NEXT_PUBLIC_TIA_LEGAL_NAME=Linka
NEXT_PUBLIC_PRIVACY_CONTACT_EMAIL=privacy@example.com
NEXT_ALLOWED_DEV_ORIGINS=localhost
TIA_E2E_BASE_URL=http://127.0.0.1:3000

# Public recruiter/admin demo sandbox (backend)
DEMO_MODE=false
DEMO_ALLOW_EXTERNAL_DISPATCH=false
DEMO_AGENT_HOURLY_TURN_LIMIT=60

# Public recruiter/admin demo (frontend server + UI flag)
TIA_DEMO_ENABLED=false
NEXT_PUBLIC_TIA_DEMO_ENABLED=false
TIA_DEMO_EMAIL=demo@example.com
TIA_DEMO_PASSWORD=replace-with-a-strong-demo-password
