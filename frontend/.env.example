# Browser-visible Supabase Auth settings only.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Canonical public application origin used for Auth callbacks in production.
NEXT_PUBLIC_APP_URL=https://app.linkaai.online
# Enable only after app.linkaai.online is live and verified. /auth/callback is exempt
# during the compatibility window so old Supabase links can still complete safely.
LINKA_LEGACY_DOMAIN_REDIRECT_ENABLED=false

# Server-only FastAPI origin. Do not prefix with NEXT_PUBLIC_.
TIA_API_URL=http://127.0.0.1:8000

# Public legal/privacy page settings.
# Use the real public-facing business/legal name when available.
NEXT_PUBLIC_TIA_LEGAL_NAME=Linka
# Recommended before publishing the Meta app. Use an inbox you actively monitor.
NEXT_PUBLIC_PRIVACY_CONTACT_EMAIL=privacy@YOUR_DOMAIN.com

# Optional public recruiter/admin demo. The credentials stay server-only.
TIA_DEMO_ENABLED=false
NEXT_PUBLIC_TIA_DEMO_ENABLED=false
TIA_DEMO_EMAIL=demo@example.com
TIA_DEMO_PASSWORD=replace-with-a-strong-demo-password
